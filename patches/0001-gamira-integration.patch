--- /dev/null
+++ b/multiplayer-bomber/project/client_config.gd
@@ -0,0 +1,11 @@
+extends RefCounted
+
+static func service_url(key: String, environment: String) -> String:
+	var value := OS.get_environment(environment)
+	if value == "":
+		var config := ConfigFile.new()
+		if config.load("res://client.cfg") == OK:
+			value = str(config.get_value("services", key, ""))
+	if value == "":
+		value = "http://localhost:30080" if key == "gamira_url" else "http://localhost:30090"
+	return value.trim_suffix("/")
