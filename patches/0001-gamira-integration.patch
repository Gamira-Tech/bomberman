diff --git a/multiplayer-bomber/project/player.gd b/multiplayer-bomber/project/player.gd
index 7e452d0658cb7af5b9f67841ca0d90be7d48c97a..ef7eab1089315b36f22457353451958dc1a4c2b1 100644
--- a/multiplayer-bomber/project/player.gd
+++ b/multiplayer-bomber/project/player.gd
@@ -25,7 +25,10 @@ func _ready() -> void:
 func _physics_process(delta: float) -> void:
 	if multiplayer.multiplayer_peer == null or str(multiplayer.get_unique_id()) == str(name):
 		# The client which this player represent will update the controls state, and notify it to everyone.
+		var was_bombing: bool = inputs.bombing
 		inputs.update()
+		if inputs.bombing and not was_bombing:
+			pass
 
 	if multiplayer.multiplayer_peer == null or is_multiplayer_authority():
 		# The server updates the position that will be notified to the clients.
@@ -34,7 +37,7 @@ func _physics_process(delta: float) -> void:
 		last_bomb_time += delta
 		if not stunned and is_multiplayer_authority() and inputs.bombing and last_bomb_time >= BOMB_RATE:
 			last_bomb_time = 0.0
-			$"../../BombSpawner".spawn([position, str(name).to_int()])
+			gamestate._spawn_bomb_rpc.rpc(position, str(name).to_int())
 	else:
 		# The client simply updates the position to the last known one.
 		position = synced_position
@@ -61,7 +64,8 @@ func _physics_process(delta: float) -> void:
 
 	if new_anim != current_anim:
 		current_anim = new_anim
-		$anim.play(current_anim)
+		if not multiplayer.is_server():
+			$anim.play(current_anim)
 
 
 @rpc("call_local")
@@ -76,6 +80,7 @@ func set_player_name(value: String) -> void:
 func exploded(_by_who: int) -> void:
 	if stunned:
 		return
-
 	stunned = true
-	$anim.play(&"stunned")
+	if not multiplayer.is_server():
+		$anim.play(&"stunned")
+	get_tree().create_timer(3.0).timeout.connect(func(): stunned = false)
