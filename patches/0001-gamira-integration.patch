diff --git a/multiplayer-bomber/project/gamira_client.gd b/multiplayer-bomber/project/gamira_client.gd
new file mode 100644
index 0000000000000000000000000000000000000000..67690e8101ee1eb57b57a4d87e8e6235bb68e159
--- /dev/null
+++ b/multiplayer-bomber/project/gamira_client.gd
@@ -0,0 +1,162 @@
+extends Node
+
+var GAMIRA_BASE: String = preload("res://client_config.gd").service_url("gamira_url", "GAMIRA_API")
+const GAME_MODE_ID := "gm_bomber"
+const POLL_INTERVAL := 2.0
+
+signal ticket_created(ticket_id: String)
+signal match_found(connection: Dictionary)
+signal ticket_cancelled()
+signal error_occurred(reason: String)
+
+var _ticket_id := ""
+var _gamira_token := ""
+var _session_id := ""
+var _poll_timer: Timer
+
+# region_id -> public API base URL, harvested from GET /regions. In a
+# multi-location deployment each region runs its own cluster behind its own
+# hostname and only that cluster can act on the region's tickets. An empty
+# api_endpoint (the single-location default) leaves this map empty and every
+# call keeps using GAMIRA_BASE.
+var _region_endpoints := {}
+# Region that owns the live ticket; set from the create response.
+var _ticket_region := ""
+
+# _base_for returns the API base that owns region_id, falling back to the
+# configured one when the region has no endpoint of its own.
+func _base_for(region_id: String) -> String:
+	if region_id != "" and _region_endpoints.has(region_id):
+		return _region_endpoints[region_id]
+	return GAMIRA_BASE
+
+func _log(msg: String) -> void:
+	print("[%s] %s" % [Time.get_datetime_string_from_system(), msg])
+
+func _ready() -> void:
+	_poll_timer = Timer.new()
+	_poll_timer.one_shot = false
+	_poll_timer.wait_time = POLL_INTERVAL
+	_poll_timer.timeout.connect(_poll_ticket)
+	add_child(_poll_timer)
+
+func create_ticket(gamira_token: String) -> void:
+	_gamira_token = gamira_token
+	_ticket_id = ""
+	_log("fetching regions for ping_latencies...")
+	var http := HTTPRequest.new()
+	add_child(http)
+	http.request_completed.connect(_on_regions_completed.bind(http))
+	http.request(GAMIRA_BASE + "/regions", ["x-token: " + _gamira_token])
+
+func _on_regions_completed(result: int, code: int, _headers: PackedStringArray, body: PackedByteArray, http: HTTPRequest) -> void:
+	http.queue_free()
+	var ping_latencies := {}
+	if result == HTTPRequest.RESULT_SUCCESS and code == 200:
+		var data: Dictionary = JSON.parse_string(body.get_string_from_utf8())
+		if data and data.has("items"):
+			for region in data["items"]:
+				var rid: String = region.get("region_id", "")
+				ping_latencies[rid] = 20
+				var ep: String = region.get("api_endpoint", "")
+				if ep != "":
+					_region_endpoints[rid] = ep
+	if ping_latencies.is_empty():
+		ping_latencies = {"eu-west": 20}  # fallback
+	_log("creating ticket game_mode=%s ping_latencies=%s" % [GAME_MODE_ID, JSON.stringify(ping_latencies)])
+	var http2 := HTTPRequest.new()
+	add_child(http2)
+	http2.request_completed.connect(_on_create_completed.bind(http2))
+	var body_str := JSON.stringify({"game_mode_id": GAME_MODE_ID, "ping_latencies": ping_latencies})
+	http2.request(GAMIRA_BASE + "/matchmaking/tickets",
+		["Content-Type: application/json", "x-token: " + _gamira_token],
+		HTTPClient.METHOD_POST, body_str)
+
+func _on_create_completed(result: int, code: int, _headers: PackedStringArray, body: PackedByteArray, http: HTTPRequest) -> void:
+	http.queue_free()
+	var body_str := body.get_string_from_utf8()
+	_log("create ticket result=%d code=%d body=%s" % [result, code, body_str])
+	if result != HTTPRequest.RESULT_SUCCESS or (code != 200 and code != 201):
+		error_occurred.emit("Failed to create ticket (HTTP %d)" % code)
+		return
+	var created: Dictionary = JSON.parse_string(body_str)
+	if created:
+		# Remember which region owns the ticket so polls and cancels go to the
+		# cluster that can actually see it.
+		_ticket_region = created.get("region_id", "")
+	var data: Dictionary = JSON.parse_string(body_str)
+	if not data:
+		error_occurred.emit("Invalid ticket response")
+		return
+	_ticket_id = data.get("ticket_id", "")
+	if _ticket_id == "":
+		error_occurred.emit("Ticket ID missing in response")
+		return
+	_log("ticket created id=%s" % _ticket_id)
+	ticket_created.emit(_ticket_id)
+	_poll_timer.start()
+
+func _poll_ticket() -> void:
+	if _ticket_id == "":
+		return
+	var http := HTTPRequest.new()
+	add_child(http)
+	http.request_completed.connect(_on_poll_completed.bind(http))
+	http.request(_base_for(_ticket_region) + "/matchmaking/tickets/" + _ticket_id,
+		["x-token: " + _gamira_token])
+
+func _on_poll_completed(result: int, code: int, _headers: PackedStringArray, body: PackedByteArray, http: HTTPRequest) -> void:
+	http.queue_free()
+	var body_str := body.get_string_from_utf8()
+	_log("poll ticket result=%d code=%d body=%s" % [result, code, body_str])
+	if result != HTTPRequest.RESULT_SUCCESS or code != 200:
+		return
+	var data: Dictionary = JSON.parse_string(body_str)
+	if not data:
+		return
+	var status: String = data.get("status", "")
+	match status:
+		"matched":
+			var conn: Dictionary = data.get("connection", {})
+			# Kept for the optional ICE tunnel, which has to name the session it is
+			# negotiating for. The match_found signature is unchanged so nothing
+			# else has to care.
+			_session_id = data.get("session_id", "")
+			_log("match found: %s" % JSON.stringify(conn))
+			_poll_timer.stop()
+			match_found.emit(conn)
+		"cancelled":
+			_poll_timer.stop()
+			_ticket_id = ""
+			ticket_cancelled.emit()
+
+func cancel_ticket() -> void:
+	_poll_timer.stop()
+	if _ticket_id == "":
+		ticket_cancelled.emit()
+		return
+	var http := HTTPRequest.new()
+	add_child(http)
+	http.request_completed.connect(_on_cancel_completed.bind(http))
+	http.request(_base_for(_ticket_region) + "/matchmaking/tickets/" + _ticket_id,
+		["x-token: " + _gamira_token],
+		HTTPClient.METHOD_DELETE)
+
+func _on_cancel_completed(_result: int, _code: int, _headers: PackedStringArray, _body: PackedByteArray, http: HTTPRequest) -> void:
+	http.queue_free()
+	_ticket_id = ""
+	ticket_cancelled.emit()
+
+
+# ---- Accessors used by the optional ICE tunnel (see ice_tunnel.gd) ----
+
+func get_session_id() -> String:
+	return _session_id
+
+
+func get_gamira_token() -> String:
+	return _gamira_token
+
+
+func get_api_base() -> String:
+	return _base_for(_ticket_region)
diff --git a/multiplayer-bomber/project/ice_tunnel.gd b/multiplayer-bomber/project/ice_tunnel.gd
new file mode 100644
index 0000000000000000000000000000000000000000..51bd4b3e912fcef6545910d198274017260bd6c1
--- /dev/null
+++ b/multiplayer-bomber/project/ice_tunnel.gd
@@ -0,0 +1,94 @@
+extends Node
+## Optional NAT-traversal tunnel for the game connection.
+##
+## Off unless GAMIRA_ICE_ENABLED is set AND the matched session advertises
+## ice_servers. With it off, nothing here runs and the client connects to the game
+## server exactly as it always has — the direct path stays the default.
+##
+## When on, this spawns gamira's ice-proxy (a small Go binary; the launcher builds
+## it and passes its path in GAMIRA_ICE_PROXY_BIN), which negotiates a WebRTC
+## tunnel to the sidecar next to the game server and presents a local UDP port.
+## ENet then dials that local port instead of the remote address, so the rest of
+## the game is unaware a tunnel exists.
+##
+## The proxy is spawned by the game rather than by the launcher because the offer
+## must be made with THIS player's token: gamira only lets a session's own members
+## negotiate a tunnel to it, and the launcher has no player token.
+
+var _pid := -1
+var _ready_path := ""
+
+## Returns true when the launcher enabled ICE and this session can use it.
+func is_available(connection: Dictionary) -> bool:
+	if OS.get_environment("GAMIRA_ICE_ENABLED") == "":
+		return false
+	if OS.get_environment("GAMIRA_ICE_PROXY_BIN") == "":
+		return false
+	var servers: Array = connection.get("ice_servers", [])
+	return not servers.is_empty()
+
+
+## Negotiates a tunnel and returns {"ip": String, "port": int} for ENet to dial,
+## or an empty Dictionary when it could not be established.
+##
+## An empty result is not fatal: the caller falls back to the direct address. A
+## relay is a fallback path, so failing to build one must not stop a player who
+## could have connected directly anyway.
+func open(session_id: String, token: String, api_base: String, timeout_seconds := 25.0) -> Dictionary:
+	var bin := OS.get_environment("GAMIRA_ICE_PROXY_BIN")
+	if session_id == "" or token == "":
+		push_warning("ice: no session/token; connecting directly")
+		return {}
+
+	# The proxy writes its chosen address here once the tunnel is up, so its
+	# existence is the "safe to dial" signal and its contents are the address.
+	# Letting the proxy pick the port (:0) avoids guessing a free one.
+	_ready_path = ProjectSettings.globalize_path("user://gamira_ice_%d.addr" % OS.get_process_id())
+	if FileAccess.file_exists(_ready_path):
+		DirAccess.remove_absolute(_ready_path)
+
+	var args := PackedStringArray([
+		"--role=client",
+		"--api", api_base,
+		"--session", session_id,
+		"--token", token,
+		"--local", "127.0.0.1:0",
+		"--ready-file", _ready_path,
+	])
+	_pid = OS.create_process(bin, args)
+	if _pid <= 0:
+		push_warning("ice: could not start %s; connecting directly" % bin)
+		return {}
+
+	var waited := 0.0
+	while waited < timeout_seconds:
+		if FileAccess.file_exists(_ready_path):
+			var addr := FileAccess.get_file_as_string(_ready_path).strip_edges()
+			var parts := addr.rsplit(":", true, 1)
+			if parts.size() == 2 and parts[1].is_valid_int():
+				print("ice: tunnel up, dialling %s" % addr)
+				return {"ip": parts[0], "port": int(parts[1])}
+			push_warning("ice: unreadable address %s; connecting directly" % addr)
+			close()
+			return {}
+		await get_tree().create_timer(0.2).timeout
+		waited += 0.2
+
+	push_warning("ice: tunnel not ready after %.0fs; connecting directly" % timeout_seconds)
+	close()
+	return {}
+
+
+## Stops the proxy. Safe to call when nothing was started, and called on match end
+## as well as on failure — the tunnel lives exactly as long as the connection.
+func close() -> void:
+	if _pid > 0:
+		OS.kill(_pid)
+		_pid = -1
+	if _ready_path != "" and FileAccess.file_exists(_ready_path):
+		DirAccess.remove_absolute(_ready_path)
+	_ready_path = ""
+
+
+func _exit_tree() -> void:
+	close()
