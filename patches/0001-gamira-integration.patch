+++ b/multiplayer-bomber/README.md
@@ -0,0 +1,11 @@
+# Multiplayer Bomber client with Gamira
+
+Edit `project/client.cfg`: `gamira_url` is the Gamira API and `platform_url` is
+the authentication platform base URL (without `/api/v1`). Environment overrides:
+`GAMIRA_API` and `PLATFORM_URL`.
+
+Run `godot --path project/` using Godot 4.6 or later. Sign in, then find a match.
+The configuration contains public URLs only. No admin credentials are needed.
+Game servers and both services are operated separately.
+
+Upstream: https://github.com/godotengine/godot-demo-projects (MIT).
diff --git a/multiplayer-bomber/project/auth_client.gd b/multiplayer-bomber/project/auth_client.gd
new file mode 100644
index 0000000000000000000000000000000000000000..6f81d32c36315bf5265319b74f59da07dbf51ca6
--- /dev/null
+++ b/multiplayer-bomber/project/auth_client.gd
@@ -0,0 +1,217 @@
+extends Node
+
+# Device flow client matching authentication-demo/samples/deviceflow/main.go pattern:
+# begin → sleep(interval) → poll → if pending: continue → if authenticated: done
+
+func _log(msg: String) -> void:
+	print("[%s] %s" % [Time.get_datetime_string_from_system(), msg])
+
+# Public authentication URL comes from client.cfg or PLATFORM_URL.
+var AUTH_BASE: String = preload("res://client_config.gd").service_url("platform_url", "PLATFORM_URL") + "/api/v1"
+const PROVIDER := "github"
+var TOKEN_PATH := "user://bomber_auth.json"
+const _STATE_B64 := "eyJhdXRoZW50aWNhdGlvblR5cGUiOiJkZXZpY2VmbG93In0="  # base64({"authenticationType":"deviceflow"})
+
+signal device_flow_started(user_code: String, verification_uri: String, interval: int)
+signal auth_completed(gamira_token: String, display_name: String)
+signal auth_failed(reason: String)
+signal token_refreshed(gamira_token: String)
+
+var _challenge_id := ""
+var _session_cookie := ""
+var _poll_interval := 5
+var _auth_demo_token := ""
+var _gamira_token := ""
+var _display_name := ""
+
+const _ADJECTIVES := ["Brave", "Swift", "Sneaky", "Lucky", "Wild", "Mighty", "Sly", "Bold", "Quick", "Fierce"]
+const _NOUNS := ["Tiger", "Wolf", "Fox", "Hawk", "Bear", "Lion", "Otter", "Raven", "Panda", "Falcon"]
+
+func _generate_random_name() -> String:
+	var a: String = _ADJECTIVES[randi() % _ADJECTIVES.size()]
+	var n: String = _NOUNS[randi() % _NOUNS.size()]
+	return "%s%s%d" % [a, n, randi() % 1000]
+
+# Builds display string. If existing _display_name already targets this email
+# (format "name:::email"), reuse its name part; otherwise generate fresh.
+func _build_display_name(email: String) -> String:
+	if email == "":
+		return ""
+	var existing := _display_name
+	var sep := existing.find(":::")
+	if sep != -1 and existing.substr(sep + 3) == email:
+		return existing
+	return "%s:::%s" % [_generate_random_name(), email]
+
+# One-shot timer: restarted from poll response so there is never a concurrent request.
+# This mirrors the sample's time.Sleep(interval) → poll → loop.
+var _poll_timer: Timer
+
+func _ready() -> void:
+	for arg in OS.get_cmdline_user_args():
+		if arg.begins_with("--player-slot="):
+			TOKEN_PATH = "user://bomber_auth_%s.json" % arg.substr("--player-slot=".length())
+			break
+	_poll_timer = Timer.new()
+	_poll_timer.one_shot = true
+	_poll_timer.timeout.connect(_do_poll)
+	add_child(_poll_timer)
+
+func begin_device_flow() -> void:
+	_poll_timer.stop()
+	_challenge_id = ""
+	_session_cookie = ""
+	_poll_interval = 5
+	var http := HTTPRequest.new()
+	add_child(http)
+	http.request_completed.connect(_on_begin_completed.bind(http))
+	http.request(AUTH_BASE + "/auth-deviceflow/" + PROVIDER, ["x-state: " + _STATE_B64])
+
+func _on_begin_completed(result: int, code: int, headers: PackedStringArray, body: PackedByteArray, http: HTTPRequest) -> void:
+	http.queue_free()
+	if result != HTTPRequest.RESULT_SUCCESS or code != 200:
+		_log("begin failed code=%d body=%s" % [code, body.get_string_from_utf8()])
+		auth_failed.emit("Failed to start device flow (HTTP %d)" % code)
+		return
+	for h in headers:
+		if h.to_lower().begins_with("set-cookie:"):
+			_session_cookie = h.substr(11).strip_edges().split(";")[0].strip_edges()
+			break
+	var data: Dictionary = JSON.parse_string(body.get_string_from_utf8())
+	if not data:
+		auth_failed.emit("Invalid begin response")
+		return
+	_challenge_id = data.get("challenge_id", "")
+	_poll_interval = max(int(data.get("interval", 5)), 5)
+	var user_code: String = data.get("user_code", "")
+	var verification_uri: String = data.get("verification_uri", "")
+	_log("Challenge: %s" % _challenge_id)
+	_log("Provider:  %s" % data.get("provider", ""))
+	_log("Type:      %s" % data.get("type", ""))
+	_log("Open:")
+	_log(verification_uri)
+	_log("Enter code:")
+	_log(user_code)
+	device_flow_started.emit(user_code, verification_uri, _poll_interval)
+	# sleep(interval) before first poll — same as sample
+	_poll_timer.start(_poll_interval)
+
+func _do_poll() -> void:
+	var hdrs := PackedStringArray(["x-challenge-id: " + _challenge_id, "x-state: " + _STATE_B64])
+	if _session_cookie != "":
+		hdrs.append("Cookie: " + _session_cookie)
+	var http := HTTPRequest.new()
+	add_child(http)
+	http.request_completed.connect(_on_poll_completed.bind(http))
+	http.request(AUTH_BASE + "/auth-deviceflow/" + PROVIDER + "/callback", hdrs)
+
+func _on_poll_completed(result: int, code: int, headers: PackedStringArray, body: PackedByteArray, http: HTTPRequest) -> void:
+	http.queue_free()
+	# refresh cookie from response (auth-demo updates session state each poll)
+	for h in headers:
+		if h.to_lower().begins_with("set-cookie:"):
+			_session_cookie = h.substr(11).strip_edges().split(";")[0].strip_edges()
+			break
+	if result != HTTPRequest.RESULT_SUCCESS or code != 200:
+		_log("poll error result=%d code=%d" % [result, code])
+		_poll_timer.start(_poll_interval)
+		return
+	var data: Dictionary = JSON.parse_string(body.get_string_from_utf8())
+	if not data:
+		_poll_timer.start(_poll_interval)
+		return
+	# Mirror sample: check Pending first, then Authenticated.
+	# Default false — matches Go's zero value for missing omitempty bool fields.
+	if data.get("pending", false):
+		_log("pending: %s" % data.get("message", ""))
+		_poll_timer.start(_poll_interval)
+		return
+	if data.get("authenticated", false):
+		_log("authenticated")
+		_auth_demo_token = data.get("token", "")
+		_display_name = _build_display_name(_extract_email(_auth_demo_token))
+		_save_tokens()
+		auth_completed.emit(_auth_demo_token, _display_name)
+
+func cancel_device_flow() -> void:
+	_poll_timer.stop()
+	_challenge_id = ""
+
+# bridges auth-demo JWT (email claim) → gamira x-token (sub+name claims)
+func _make_gamira_token(auth_demo_jwt: String) -> String:
+	var email := _extract_email(auth_demo_jwt)
+	if email == "":
+		return ""
+	var payload := '{"sub":"%s","name":"%s"}' % [email, email]
+	var b64 := Marshalls.utf8_to_base64(payload).replace("+", "-").replace("/", "_").rstrip("=")
+	return "e30." + b64 + ".bridge"
+
+func _extract_email(jwt: String) -> String:
+	var parts := jwt.split(".")
+	if parts.size() != 3:
+		return ""
+	var b64 := parts[1].replace("-", "+").replace("_", "/")
+	while b64.length() % 4 != 0:
+		b64 += "="
+	var payload: Dictionary = JSON.parse_string(Marshalls.base64_to_utf8(b64))
+	if not payload:
+		return ""
+	return payload.get("email", "")
+
+func refresh_token() -> void:
+	if _auth_demo_token == "":
+		auth_failed.emit("No stored token to refresh")
+		return
+	var http := HTTPRequest.new()
+	add_child(http)
+	http.request_completed.connect(_on_refresh_completed.bind(http))
+	http.request(AUTH_BASE + "/auth/refresh-token", ["x-token: " + _auth_demo_token])
+
+func _on_refresh_completed(result: int, code: int, _headers: PackedStringArray, body: PackedByteArray, http: HTTPRequest) -> void:
+	http.queue_free()
+	if result != HTTPRequest.RESULT_SUCCESS or code != 200:
+		auth_failed.emit("Token refresh failed")
+		return
+	_auth_demo_token = body.get_string_from_utf8().strip_edges().trim_prefix('"').trim_suffix('"')
+	_gamira_token = _make_gamira_token(_auth_demo_token)
+	if _gamira_token == "":
+		auth_failed.emit("Refreshed token malformed")
+		return
+	_display_name = _build_display_name(_extract_email(_auth_demo_token))
+	_save_tokens()
+	token_refreshed.emit(_gamira_token)
+
+func get_gamira_token() -> String:
+	return _auth_demo_token
+
+func get_display_name() -> String:
+	return _display_name
+
+func load_stored_tokens() -> bool:
+	if not FileAccess.file_exists(TOKEN_PATH):
+		return false
+	var f := FileAccess.open(TOKEN_PATH, FileAccess.READ)
+	if not f:
+		return false
+	var data: Dictionary = JSON.parse_string(f.get_as_text())
+	if not data:
+		return false
+	_auth_demo_token = data.get("auth_demo_token", "")
+	_display_name = data.get("display_name", "")
+	return _auth_demo_token != ""
+
+func _save_tokens() -> void:
+	var f := FileAccess.open(TOKEN_PATH, FileAccess.WRITE)
+	if not f:
+		return
+	f.store_string(JSON.stringify({
+		"auth_demo_token": _auth_demo_token,
+		"display_name": _display_name,
+	}))
+
+func clear_stored_tokens() -> void:
+	_auth_demo_token = ""
+	_gamira_token = ""
+	_display_name = ""
+	if FileAccess.file_exists(TOKEN_PATH):
+		DirAccess.remove_absolute(TOKEN_PATH)
